import java.util.Arrays;

public class GenericSumCalculator {

    public static <T extends Number> double calculateSum(T[] array) {
        if (array == null || array.length == 0) {
            return 0.0;
        }
        
        double sum = 0.0;
        for (T element : array) {
            if (element != null) {
                sum += element.doubleValue();
            }
        }
        return sum;
    }

    public static void main(String[] args) {
        Integer[] integerArray = {10, 20, 30, 40, 50};
        System.out.println("Integer Array: " + Arrays.toString(integerArray));
        System.out.println("Sum of Integers: " + calculateSum(integerArray));
        System.out.println();

        Float[] floatArray = {1.5f, 2.5f, 3.5f, 4.5f};
        System.out.println("Float Array: " + Arrays.toString(floatArray));
        System.out.println("Sum of Floats: " + calculateSum(floatArray));
        System.out.println();

        Double[] doubleArray = {10.25, 20.50, 30.75};
        System.out.println("Double Array: " + Arrays.toString(doubleArray));
        System.out.println("Sum of Doubles: " + calculateSum(doubleArray));
    }
}
